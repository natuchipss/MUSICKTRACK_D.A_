<?xml version="1.0"?>
<!-- Reglas de diseño de PHPMD para MusicTrack. Ver docs/EVALUACION_SOFTWARE.md -->
<ruleset name="MusicTrack"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>Los seis conjuntos de reglas de PHPMD con los umbrales por defecto.</description>

    <rule ref="rulesets/cleancode.xml"/>
    <rule ref="rulesets/codesize.xml"/>
    <rule ref="rulesets/design.xml"/>
    <rule ref="rulesets/naming.xml"/>
    <rule ref="rulesets/unusedcode.xml"/>
    <rule ref="rulesets/controversial.xml">
        <!-- El proyecto es PHP procedimental sin framework: leer $_POST, $_GET y $_SESSION
             en los puntos de entrada es su diseño, no un defecto. -->
        <exclude name="Superglobals"/>
    </rule>
</ruleset>
